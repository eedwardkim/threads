# Copy to .env.local (never committed). Names/placeholders only.

# --- Supabase Auth (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # or NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy name)
NEXT_PUBLIC_AUTH_GOOGLE=false              # true only when the Google provider is configured in Supabase Auth

# --- Postgres (server-only) ---
# Runtime: Supabase transaction-mode pooler (port 6543). Prepared statements are disabled automatically.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable   # locally the same DB; on Supabase use the pooler URL whose user has been granted the threads_app role by the migration
# Migrations / importer: session pooler (5432) or direct connection; used by `npm run db:migrate` and `db:import-sqlite`.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
# Optional PEM CA bundle for the database TLS chain; certificate validation is never disabled for non-local hosts.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=4

# --- Tests only (never set on Vercel) ---
TEST_DATABASE_URL=                          # isolated Postgres for `npm run test:pg`; defaults to DATABASE_URL
TEST_DIRECT_DATABASE_URL=
SUPABASE_SECRET_KEY=                        # or SUPABASE_SERVICE_ROLE_KEY; creates disposable e2e/perf users via the Auth admin API

# --- Inference ---
USE_MOCK=true                               # explicit mock provider; refused in Vercel production unless THREADS_ALLOW_MOCK_IN_PRODUCTION=true
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
THREADS_COMPRESSION_PROVIDER=               # deepseek | anthropic | openai; default: first configured in that order
THREADS_COMPRESSION_TIMEOUT_MS=45000

# --- Limits (enforced in Postgres, so they hold across instances) ---
THREADS_RATE_LIMIT_PER_MINUTE=30
THREADS_MAX_CONCURRENT_PER_USER=4
THREADS_MAX_CONCURRENT_TOTAL=50
THREADS_DAILY_TOKEN_LIMIT=0                 # 0 = unlimited
THREADS_LOG_TIMING=false
